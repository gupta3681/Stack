# ── Build stage ─────────────────────────────────────────────────────────
FROM node:23-alpine AS build

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY tsconfig.json vite.config.ts index.html ./
COPY src ./src
# Vite copies anything in public/ verbatim into dist/ — favicon, robots.txt,
# any other static asset. Missing this line means /favicon.svg 404s in prod.
COPY public ./public
RUN npm run build


# ── Serve stage ─────────────────────────────────────────────────────────
FROM nginxinc/nginx-unprivileged:1.27-alpine

# Put the nginx config in the templates directory so the base image's
# entrypoint (envsubst) renders ${BACKEND_URL} at container startup, writing
# the result to /etc/nginx/conf.d/default.conf before nginx boots.
COPY nginx.conf /etc/nginx/templates/default.conf.template

# Default the proxy target to the docker-compose service name so local
# `docker compose -f docker-compose.yml -f docker-compose.prod.yml up` works
# unchanged. Override in Railway/Fly/etc. by setting BACKEND_URL to that
# platform's internal hostname for the backend service.
ENV BACKEND_URL=http://backend:8000/ \
    NGINX_ENVSUBST_FILTER=^BACKEND_URL$

# Drop in the built static assets from the build stage.
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
