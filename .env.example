# Copy this file to `.env` and fill in real values.
# docker-compose loads .env automatically from the repo root.

# ── Postgres ──
POSTGRES_USER=stack
POSTGRES_PASSWORD=stack
POSTGRES_DB=stack

# ── Backend ──
# Set to "production" in deployed environments. When production is set, the
# backend refuses to fall back to ephemeral SQLite if DATABASE_URL is missing.
APP_ENV=development

# Comma-separated origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to "true" when serving over HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=false

# Auth abuse protection. Defaults are safe for a small public app; tune if needed.
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_LOGIN_IP_ATTEMPTS=20
AUTH_RATE_LIMIT_LOGIN_EMAIL_ATTEMPTS=8
AUTH_RATE_LIMIT_SIGNUP_WINDOW_SECONDS=3600
AUTH_RATE_LIMIT_SIGNUP_IP_ATTEMPTS=10

# Public unauth endpoints (e.g. /public/stacks/{slug}) — per-IP read throttle.
# Defaults: 60 requests per IP per 60s. Generous for normal browsing, tight
# enough to slow down scraping/enumeration.
PUBLIC_READ_RATE_LIMIT_IP_ATTEMPTS=60
PUBLIC_READ_RATE_LIMIT_WINDOW_SECONDS=60

# Client-IP resolution for the rate limiter.
# - On Railway (or anything Envoy-fronted): no setting needed. The backend
#   prefers X-Envoy-External-Address, which Envoy fills automatically.
# - On a generic deploy with nginx (no Envoy edge): set to the number of
#   proxies in front of the backend. 1 = nginx only. 2 = CDN -> nginx.
# - Local dev: leave at 0. Falls back to the TCP peer address.
TRUSTED_PROXY_HOPS=0

# ── Prod overlay only ──
# Host port nginx publishes the built frontend on. App+API are served from this
# single port (nginx proxies /api to the backend container internally).
HOST_PORT=8080
