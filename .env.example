# Copy this file to `.env` and fill in real values.
# docker-compose loads .env automatically from the repo root.

# ── Postgres ──
POSTGRES_USER=stack
POSTGRES_PASSWORD=stack
POSTGRES_DB=stack

# ── Backend ──
# Set to "production" in deployed environments. When production is set, the
# backend refuses to fall back to ephemeral SQLite if DATABASE_URL is missing.
APP_ENV=development

# Comma-separated origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to "true" when serving over HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=false

# Auth abuse protection. Defaults are safe for a small public app; tune if needed.
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_LOGIN_IP_ATTEMPTS=20
AUTH_RATE_LIMIT_LOGIN_EMAIL_ATTEMPTS=8
AUTH_RATE_LIMIT_SIGNUP_WINDOW_SECONDS=3600
AUTH_RATE_LIMIT_SIGNUP_IP_ATTEMPTS=10

# ── Prod overlay only ──
# Host port nginx publishes the built frontend on. App+API are served from this
# single port (nginx proxies /api to the backend container internally).
HOST_PORT=8080
